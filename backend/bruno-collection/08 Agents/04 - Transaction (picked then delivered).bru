meta {
  name: Status to picked (agent)
  type: http
  seq: 4
}

patch {
  url: {{orderBase}}/agents/orders/{{orderId}}/status
  body: json
  auth: none
}

headers {
  Cookie: access_token={{agent1Token}}
  X-Region: {{region}}
  Idempotency-Key: {{agentStatusIdempotencyKey}}
}

body:json {
  {
    "status": "{{pickedStatus}}"
  }
}
