meta {
  name: Create branch (owner)
  type: http
  seq: 8
}

post {
  url: {{coreBase}}/restaurants/{{restaurantId}}/branches
  body: json
  auth: none
}

headers {
  Cookie: access_token={{owner1Token}}
}

body:json {
  {
    "countryCode": "{{newBranchCountryCode}}",
    "addressText": "{{newBranchAddress}}",
    "label": "{{newBranchLabel}}",
    "lat": {{newBranchLat}},
    "lng": {{newBranchLng}},
    "opensAt": "{{newBranchOpensAt}}",
    "closesAt": "{{newBranchClosesAt}}",
    "acceptOrders": {{newBranchAcceptOrders}}
  }
}
