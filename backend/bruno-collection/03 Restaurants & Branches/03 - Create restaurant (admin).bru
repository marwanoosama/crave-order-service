meta {
  name: Create restaurant (admin)
  type: http
  seq: 3
}

post {
  url: {{coreBase}}/restaurants
  body: json
  auth: none
}

headers {
  Cookie: access_token={{adminToken}}
}

body:json {
  {
    "name": "{{newRestaurantName}}",
    "owner": {
      "email": "{{newRestaurantOwnerEmail}}",
      "phone": "{{newRestaurantOwnerPhone}}",
      "name": "{{newRestaurantOwnerName}}",
      "password": "{{newRestaurantOwnerPassword}}"
    },
    "logoURL": "{{newRestaurantLogoUrl}}",
    "primaryCountry": "{{region}}"
  }
}
