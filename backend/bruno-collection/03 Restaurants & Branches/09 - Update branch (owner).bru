meta {
  name: Update branch (owner)
  type: http
  seq: 9
}

patch {
  url: {{coreBase}}/branches/{{branchId}}
  body: json
  auth: none
}

headers {
  Cookie: access_token={{owner1Token}}
}

body:json {
  {
    "label": "{{updatedBranchLabel}}",
    "acceptOrders": {{updatedBranchAcceptOrders}}
  }
}
