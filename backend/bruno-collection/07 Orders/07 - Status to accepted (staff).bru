meta {
  name: Status to accepted (staff)
  type: http
  seq: 7
}

patch {
  url: {{orderBase}}/restaurants/{{restaurantId}}/branches/{{branchId}}/orders/{{orderId}}/status
  body: json
  auth: none
}

headers {
  Cookie: access_token={{staff1Token}}
  X-Region: {{region}}
  Idempotency-Key: {{statusAcceptedIdempotencyKey}}
}

body:json {
  {
    "status": "{{acceptedStatus}}"
  }
}
