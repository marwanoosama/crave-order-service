meta {
  name: Status to preparing (staff)
  type: http
  seq: 8
}

patch {
  url: {{orderBase}}/restaurants/{{restaurantId}}/branches/{{branchId}}/orders/{{orderId}}/status
  body: json
  auth: none
}

headers {
  Cookie: access_token={{staff1Token}}
  X-Region: {{region}}
  Idempotency-Key: {{statusPreparingIdempotencyKey}}
}

body:json {
  {
    "status": "{{preparingStatus}}"
  }
}
