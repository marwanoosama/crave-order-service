meta {
  name: Status to ready (manager)
  type: http
  seq: 9
}

patch {
  url: {{orderBase}}/restaurants/{{restaurantId}}/branches/{{branchId}}/orders/{{orderId}}/status
  body: json
  auth: none
}

headers {
  Cookie: access_token={{manager1Token}}
  X-Region: {{region}}
  Idempotency-Key: {{statusReadyIdempotencyKey}}
}

body:json {
  {
    "status": "{{readyStatus}}"
  }
}
