meta {
  name: Status (admin)
  type: http
  seq: 10
}

patch {
  url: {{orderBase}}/admin/orders/{{orderId}}/status
  body: json
  auth: none
}

headers {
  Cookie: access_token={{adminToken}}
  X-Region: {{region}}
  Idempotency-Key: {{statusAdminIdempotencyKey}}
}

body:json {
  {
    "status": "{{cancelledStatus}}",
    "reason": "{{adminCancelReason}}"
  }
}
