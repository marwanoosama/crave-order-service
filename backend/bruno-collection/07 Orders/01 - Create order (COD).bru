meta {
  name: Create order (COD)
  type: http
  seq: 1
}

post {
  url: {{orderBase}}/orders
  body: json
  auth: none
}

headers {
  Cookie: access_token={{customer1Token}}
  X-Region: {{region}}
  Idempotency-Key: {{codOrderIdempotencyKey}}
}

body:json {
  {
    "branchId": {{branchId}},
    "customerAddressId": {{customerAddressId}},
    "paymentMethod": "{{codPaymentMethod}}",
    "items": [
      {
        "productId": {{productId}},
        "quantity": {{orderQuantity}}
      }
    ]
  }
}

script:post-response {
  const {data} = res.getBody();
    if (data && data.publicId) { bru.setEnvVar("orderId", data.publicId); }
}
