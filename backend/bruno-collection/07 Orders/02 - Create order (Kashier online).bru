meta {
  name: Create order (online / Kashier)
  type: http
  seq: 2
}

post {
  url: {{orderBase}}/orders
  body: json
  auth: none
}

headers {
  Cookie: access_token={{customer1Token}}
  X-Region: {{region}}
  Idempotency-Key: {{onlineOrderIdempotencyKey}}
}

body:json {
  {
    "branchId": {{branchId}},
    "customerAddressId": {{customerAddressId}},
    "paymentMethod": "{{onlinePaymentMethod}}",
    "items": [
      {
        "productId": {{onlineProductId}},
        "quantity": {{orderQuantity}}
      }
    ]
  }
}

script:post-response {
  const {data} = res.getBody();
  if (data && data.publicId) {
    bru.setEnvVar("onlineOrderId", data.publicId);
    bru.setEnvVar("onlineOrderTotalMinor", String(data.total));
    if (data.paymentInfo && data.paymentInfo.redirectUrl) {
      bru.setEnvVar("kashierRedirectUrl", data.paymentInfo.redirectUrl);
    }
  }
}
