meta {
  name: Status → accepted (staff)
  type: http
  seq: 1
}

patch {
  url: {{orderBase}}/restaurants/1/branches/1/orders/{{orderId}}/status
  body: json
  auth: none
}

headers {
  Cookie: access_token={{staffToken}}
  X-Region: {{region}}
  Idempotency-Key: brave-status-1
}

body:json {
  {
    "status": "accepted"
  }
}
