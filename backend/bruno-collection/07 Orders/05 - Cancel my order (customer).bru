meta {
  name: Cancel my order (customer)
  type: http
  seq: 5
}

patch {
  url: {{orderBase}}/customer/orders/{{orderId}}/status
  body: json
  auth: none
}

headers {
  Cookie: access_token={{customer1Token}}
  X-Region: {{region}}
  Idempotency-Key: {{cancelOrderIdempotencyKey}}
}

body:json {
  {
    "status": "{{cancelledStatus}}",
    "reason": "{{cancelReason}}"
  }
}
