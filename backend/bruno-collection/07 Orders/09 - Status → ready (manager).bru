meta {
  name: Status → ready (manager)
  type: http
  seq: 1
}

patch {
  url: {{orderBase}}/restaurants/1/branches/1/orders/{{orderId}}/status
  body: json
  auth: none
}

headers {
  Cookie: access_token={{managerToken}}
  X-Region: {{region}}
  Idempotency-Key: brave-status-3
}

body:json {
  {
    "status": "ready"
  }
}
