meta {
  name: Init Payment Session
  type: http
  seq: 1
}

post {
  url: http://localhost:4000/payments/init?region=eg
  body: json
  auth: inherit
}

params:query {
  region: eg
}

headers {
  Content-Type: application/json
  Authorization: Bearer <YOUR_JWT>
  region: eg
}

body:json {
  {
    "orderId": "order-123"
  }
}

settings {
  encodeUrl: true
  timeout: 0
  forwardAuthorizationHeader: false
}
