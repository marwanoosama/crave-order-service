meta {
  name: Record payout (admin)
  type: http
  seq: 3
}

post {
  url: {{orderBase}}/admin/restaurants/{{restaurantId}}/payouts
  body: json
  auth: none
}

headers {
  Cookie: access_token={{adminToken}}
  X-Region: {{region}}
  Idempotency-Key: {{payoutIdempotencyKey}}
}

body:json {
  {
    "restaurantId": {{restaurantId}},
    "amount": {{payoutAmount}},
    "currency": "{{payoutCurrency}}",
    "providerReferenceId": "{{payoutIdempotencyKey}}",
    "note": "{{payoutNote}}"
  }
}
