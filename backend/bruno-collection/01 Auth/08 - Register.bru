meta {
  name: Register
  type: http
  seq: 8
}

post {
  url: {{coreBase}}/auth/register
  body: json
  auth: none
}

body:json {
  {
    "email": "{{registerEmail}}",
    "phone": "{{registerPhone}}",
    "name": "{{registerName}}",
    "password": "{{registerPassword}}",
    "role": "customer"
  }
}
