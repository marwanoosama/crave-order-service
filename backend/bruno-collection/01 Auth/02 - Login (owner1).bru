meta {
  name: Login (owner1)
  type: http
  seq: 2
}

post {
  url: {{coreBase}}/auth/login
  body: json
  auth: none
}

body:json {
  {
    "email": "{{owner1Email}}",
    "password": "{{testPassword}}"
  }
}

script:post-response {
  const {data} = res.getBody();
    if (data && data.accessToken) {
      bru.setEnvVar("owner1Token", data.accessToken);
      bru.setEnvVar("owner1Refresh", data.refreshToken || "");
      bru.setEnvVar("ownerToken", data.accessToken);
      bru.setEnvVar("ownerRefresh", data.refreshToken || "");
    }
}
