meta {
  name: Login (owner1)
  type: http
  seq: 2
}

post {
  url: {{coreBase}}/auth/login
  body: json
  auth: none
}

body:json {
  {
    "email": "owner1@crave.io",
    "password": "Password123!"
  }
}

script:post-response {
  const {data} = res.getBody();
    if (data && data.accessToken) {
      bru.setEnvVar("ownerToken", data.accessToken);
      bru.setEnvVar("ownerRefresh", data.refreshToken || "");
    }
}
