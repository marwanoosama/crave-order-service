meta {
  name: Login (manager1)
  type: http
  seq: 4
}

post {
  url: {{coreBase}}/auth/login
  body: json
  auth: none
}

body:json {
  {
    "email": "{{manager1Email}}",
    "password": "{{testPassword}}"
  }
}

script:post-response {
  const {data} = res.getBody();
    if (data && data.accessToken) {
      bru.setEnvVar("manager1Token", data.accessToken);
      bru.setEnvVar("manager1Refresh", data.refreshToken || "");
      bru.setEnvVar("managerToken", data.accessToken);
      bru.setEnvVar("managerRefresh", data.refreshToken || "");
    }
}
