meta {
  name: Login (owner2)
  type: http
  seq: 3
}

post {
  url: {{coreBase}}/auth/login
  body: json
  auth: none
}

body:json {
  {
    "email": "owner2@crave.io",
    "password": "Password123!"
  }
}

script:post-response {
  const {data} = res.getBody();
    if (data && data.accessToken) {
      bru.setEnvVar("owner2Token", data.accessToken);
      bru.setEnvVar("owner2Refresh", data.refreshToken || "");
    }
}
