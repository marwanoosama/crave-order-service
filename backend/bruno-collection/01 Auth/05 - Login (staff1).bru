meta {
  name: Login (staff1)
  type: http
  seq: 5
}

post {
  url: {{coreBase}}/auth/login
  body: json
  auth: none
}

body:json {
  {
    "email": "staff1@crave.io",
    "password": "Password123!"
  }
}

script:post-response {
  const {data} = res.getBody();
    if (data && data.accessToken) {
      bru.setEnvVar("staffToken", data.accessToken);
      bru.setEnvVar("staffRefresh", data.refreshToken || "");
    }
}
