meta {
  name: Login (admin)
  type: http
  seq: 1
}

post {
  url: {{coreBase}}/auth/login
  body: json
  auth: none
}

body:json {
  {
    "email": "admin@crave.io",
    "password": "Password123!"
  }
}

script:post-response {
  const {data} = res.getBody();
    if (data && data.accessToken) {
      bru.setEnvVar("adminToken", data.accessToken);
      bru.setEnvVar("adminRefresh", data.refreshToken || "");
    }
}
