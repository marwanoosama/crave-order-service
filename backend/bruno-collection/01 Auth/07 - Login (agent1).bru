meta {
  name: Login (agent1)
  type: http
  seq: 7
}

post {
  url: {{coreBase}}/auth/login
  body: json
  auth: none
}

body:json {
  {
    "email": "agent1@crave.io",
    "password": "Password123!"
  }
}

script:post-response {
  const {data} = res.getBody();
    if (data && data.accessToken) {
      bru.setEnvVar("agentToken", data.accessToken);
      bru.setEnvVar("agentRefresh", data.refreshToken || "");
    }
}
