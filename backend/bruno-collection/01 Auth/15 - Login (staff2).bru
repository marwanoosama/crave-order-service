meta {
  name: Login (staff2)
  type: http
  seq: 15
}

post {
  url: {{coreBase}}/auth/login
  body: json
  auth: none
}

body:json {
  {
    "email": "{{staff2Email}}",
    "password": "{{testPassword}}"
  }
}

script:post-response {
  const {data} = res.getBody();
  if (data && data.accessToken) {
    bru.setEnvVar("staff2Token", data.accessToken);
    bru.setEnvVar("staff2Refresh", data.refreshToken || "");
  }
}
