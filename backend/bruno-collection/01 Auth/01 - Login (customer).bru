meta {
  name: Login (customer)
  type: http
  seq: 1
}

post {
  url: {{coreBase}}/auth/login
  body: json
  auth: none
}

body:json {
  {
    "email": "{{customer1Email}}",
    "password": "{{testPassword}}"
  }
}

script:post-response {
  const {data} = res.getBody();
    if (data && data.accessToken) {
      bru.setEnvVar("customer1Token", data.accessToken);
      bru.setEnvVar("customer1Refresh", data.refreshToken || "");
      bru.setEnvVar("customerToken", data.accessToken);
      bru.setEnvVar("customerRefresh", data.refreshToken || "");
    }
}
