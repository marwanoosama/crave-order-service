meta {
  name: Reserve stock
  type: http
  seq: 4
}

post {
  url: {{coreBase}}/internal/branches/{{branchId}}/reserve-stock
  body: json
  auth: none
}

headers {
  api-key: {{internalApiKey}}
  Idempotency-Key: {{reserveIdempotencyKey}}
}

body:json {
  {
    "items": [
      {
        "productId": {{reserveProductId}},
        "quantity": {{reserveQuantity}}
      }
    ]
  }
}
