meta {
  name: Release stock
  type: http
  seq: 5
}

post {
  url: {{coreBase}}/internal/branches/{{branchId}}/release-stock
  body: json
  auth: none
}

headers {
  api-key: {{internalApiKey}}
}

body:json {
  {
    "items": [
      {
        "productId": {{reserveProductId}},
        "quantity": {{reserveQuantity}}
      }
    ],
    "reservationId": {{reservationId}}
  }
}
