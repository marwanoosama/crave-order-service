meta {
  name: Set member branches
  type: http
  seq: 6
}

put {
  url: {{coreBase}}/restaurants/{{restaurantId}}/members/{{memberId}}/branches
  body: json
  auth: none
}

headers {
  Cookie: access_token={{owner1Token}}
}

body:json {
  {
    "branchIds": [
      {{branchId}},
      {{branch2Id}}
    ]
  }
}
