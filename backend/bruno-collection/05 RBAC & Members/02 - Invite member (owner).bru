meta {
  name: Invite member (owner)
  type: http
  seq: 2
}

post {
  url: {{coreBase}}/restaurants/{{restaurantId}}/members
  body: json
  auth: none
}

headers {
  Cookie: access_token={{owner1Token}}
}

body:json {
  {
    "email": "{{memberEmail}}",
    "name": "{{memberName}}",
    "phoneNumber": "{{memberPhone}}",
    "role": "{{memberRole}}",
    "branchIds": [
      {{branchId}}
    ]
  }
}
