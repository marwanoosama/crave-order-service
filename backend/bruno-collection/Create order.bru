meta {
  name: Create order
  type: http
  seq: 2
}

post {
  url: http://localhost:4000/orders?region=eg
  body: json
  auth: inherit
}

params:query {
  region: eg
}

headers {
  Content-Type: application/json
  Authorization: Bearer <YOUR_JWT>
  region: eg
}

body:json {
  {
    "restaurantId": 1,
    "items": [
      {
        "productId": 5,
        "qty": 2
      }
    ],
    "deliveryAddress": "123 Main St"
  }
}

settings {
  encodeUrl: false
  forwardAuthorizationHeader: false
}
