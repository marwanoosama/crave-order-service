meta {
  name: Kashier webhook (SUCCESS)
  type: http
  seq: 1
}

post {
  url: {{orderBase}}/payments/webhook/kashier?region={{region}}
  body: json
  auth: none
}

headers {
  x-kashier-signature: {{kashierWebhookSignature}}
}

body:json {
  {
    "event": "pay",
    "data": {
      "amount": "{{kashierAmount}}",
      "currency": "{{kashierCurrency}}",
      "merchantOrderId": "{{onlineOrderId}}",
      "kashierOrderId": "{{kashierOrderId}}",
      "method": "{{kashierMethod}}",
      "orderReference": "{{kashierOrderReference}}",
      "status": "{{kashierStatus}}",
      "transactionId": "{{kashierTransactionId}}",
      "transactionResponseCode": "{{kashierResponseCode}}",
      "signatureKeys": ["amount", "currency", "merchantOrderId", "kashierOrderId", "method", "orderReference", "status", "transactionId", "transactionResponseCode"]
    }
  }
}

script:pre-request {
  // Signs the webhook exactly like Kashier does: HMAC-SHA256 over the sorted,
  // URL-encoded signatureKeys values, keyed with KASHIER_API_KEY.
  // crypto-js is a Bruno inbuilt library, so this works in Safe Mode too.
  // The computed signature overrides the header AND the body is rebuilt from
  // the same values, so header and payload can never drift apart.
  const CryptoJS = require('crypto-js');
  const data = {
    amount: (Number(bru.getEnvVar('onlineOrderTotalMinor') || 0) / 100).toFixed(2),
    currency: bru.getEnvVar('kashierCurrency'),
    merchantOrderId: bru.getEnvVar('onlineOrderId'),
    kashierOrderId: bru.getEnvVar('kashierOrderId'),
    method: bru.getEnvVar('kashierMethod'),
    orderReference: bru.getEnvVar('kashierOrderReference'),
    status: bru.getEnvVar('kashierStatus'),
    // fresh transaction id on every send — the server de-dupes on this field,
    // so a reused id would be 200-but-skipped as a duplicate
    transactionId: 'bruno-tx-' + Date.now(),
    transactionResponseCode: bru.getEnvVar('kashierResponseCode'),
    signatureKeys: ['amount', 'currency', 'merchantOrderId', 'kashierOrderId', 'method', 'orderReference', 'status', 'transactionId', 'transactionResponseCode'],
  };
  const keys = ['amount', 'currency', 'kashierOrderId', 'merchantOrderId', 'method', 'orderReference', 'status', 'transactionId', 'transactionResponseCode'];
  const payload = keys.sort().map(function (k) { return k + '=' + encodeURIComponent(data[k]); }).join('&');
  const sig = CryptoJS.HmacSHA256(payload, bru.getEnvVar('kashierApiKey')).toString(CryptoJS.enc.Hex);
  req.setHeader('x-kashier-signature', sig);
  req.setBody({event: 'pay', data: data});
}

docs {
  # Kashier webhook (already automated — usually don't need to touch anything)

  Locally, Kashier can NOT reach localhost:4000 (KASHIER_WEBHOOK_URL is not
  reachable from the internet), so *you* play Kashier: after placing an online
  order, send this request to confirm the payment.

  The pre-request script builds the body and the `x-kashier-signature` header
  from the environment ({{onlineOrderId}}, {{onlineOrderTotalMinor}}, the
  kashier* fields and {{kashierApiKey}}), so it always matches the order that
  `02 - Create order (Kashier online)` last created — no manual signing needed.

  Expected: `200 {"success":true}` and the order moves `pending_payment → placed`
  (fires `order.created` to the branch room and `order.status_changed` to the
  customer room over WebSocket).

  Each send generates a fresh `transactionId`, so it always processes — the
  server de-dupes retries by transaction id.

  (the "02 - Create order (Kashier online)" request already saves the order id,
  total and redirectUrl into the environment; open `{{kashierRedirectUrl}}` in a
  browser to see the real Kashier test checkout page)
}
