meta {
  name: Create product (owner)
  type: http
  seq: 5
}

post {
  url: {{coreBase}}/restaurants/{{restaurantId}}/products
  body: json
  auth: none
}

headers {
  Cookie: access_token={{owner1Token}}
}

body:json {
  {
    "name": "{{newProductName}}",
    "description": "{{newProductDescription}}",
    "price": {{newProductPrice}},
    "imageUrl": "{{newProductImageUrl}}"
  }
}
