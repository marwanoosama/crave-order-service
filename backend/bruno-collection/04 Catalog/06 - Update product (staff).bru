meta {
  name: Update product (staff)
  type: http
  seq: 6
}

patch {
  url: {{coreBase}}/products/{{productId}}?branchId={{branchId}}
  body: json
  auth: none
}

headers {
  Cookie: access_token={{staff1Token}}
}

body:json {
  {
    "stock": {{updatedProductStock}},
    "price": {{updatedProductPrice}}
  }
}
