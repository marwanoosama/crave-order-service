meta {
  name: Create address
  type: http
  seq: 4
}

post {
  url: {{coreBase}}/customer/addresses
  body: json
  auth: none
}

headers {
  Cookie: access_token={{customer1Token}}
}

body:json {
  {
    "label": "{{addressLabel}}",
    "addressText": "{{addressText}}",
    "lat": {{addressLat}},
    "lng": {{addressLng}},
    "isDefault": {{addressIsDefault}}
  }
}
